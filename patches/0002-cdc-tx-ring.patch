+
+    size_t free() const { return kCdcTxRingSize - size; }
+
+    void Push(const char* data, size_t length) {
+      const size_t put = (start + size) % kCdcTxRingSize;
+      const size_t first = std::min(length, kCdcTxRingSize - put);
+      std::memcpy(&buf[put], data, first);
+      std::memcpy(&buf[0], data + first, length - first);
+      size += length;
+    }
+
+    size_t Pop(char* dest, size_t max) {
+      const size_t length = std::min(max, size);
+      const size_t first = std::min(length, kCdcTxRingSize - start);
+      std::memcpy(dest, &buf[start], first);
+      std::memcpy(dest + first, &buf[0], length - first);
+      start = (start + length) % kCdcTxRingSize;
+      size -= length;
+      return length;
+    }
